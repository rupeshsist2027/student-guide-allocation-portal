# ==============================================================================
# Student Guide Allocation Portal - Environment Variable Template
# Copy to .env for local development ONLY. NEVER commit .env to GitHub!
# ==============================================================================

# --- Frontend (Vercel / Cloudflare Pages / Vite Build Env) ---
# Leave empty locally so Vite proxies /api -> http://localhost:8081.
# In Vercel / Cloudflare Pages production settings, set to your Render URL (no trailing slash):
# Example: https://sgap-backend-api.onrender.com
VITE_API_BASE_URL=

# --- Backend Spring Profile & Server Port ---
# Local dev: dev | Production (Render): prod
SPRING_PROFILES_ACTIVE=dev
PORT=8081

# --- Cloud / Local MySQL Database ---
# Local example:
#   DB_URL=jdbc:mysql://localhost:3306/student_guide_allocation_portal?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true
#   DB_USER=root
#   DB_PASSWORD=your_local_mysql_password
#
# TiDB Cloud Starter (Serverless Free Tier) production example:
#   DB_URL=jdbc:mysql://gateway01.<region>.prod.aws.tidbcloud.com:4000/student_guide_allocation_portal?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3&serverTimezone=UTC&rewriteBatchedStatements=true&createDatabaseIfNotExist=true
#   DB_USER=<tidb_cluster_prefix>.root
#   DB_PASSWORD=<tidb_generated_password>
DB_URL=jdbc:mysql://localhost:3306/student_guide_allocation_portal?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true
DB_USER=root
DB_PASSWORD=REPLACE_WITH_YOUR_DB_PASSWORD

# --- Connection Pool & SQL Schema Init (Tuned for 512MB Render Free Tier) ---
DB_POOL_MAX=5
DB_POOL_MIN=1
# Keep 'always' on initial setup (schema.sql uses CREATE TABLE IF NOT EXISTS);
# optional 'never' after schema is verified in production.
SQL_INIT_MODE=always

# --- JWT Security (MUST be >= 32 characters; Render can auto-generate) ---
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_CHARS_RANDOM_PRODUCTION_JWT_SECRET_KEY

# --- CORS Allowed Frontend Origins (comma-separated, HTTPS in production, NO spaces/wildcards) ---
# Example: https://student-guide-portal.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Initial Admin Account Bootstrap (used only if admin user does not exist yet) ---
ADMIN_USERNAME=ADM001
ADMIN_EMAIL=admin@university.edu
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
